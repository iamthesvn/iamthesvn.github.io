---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About iamthesvn — financial markets analyst turned developer, focused on Bitcoin, Rust, and sovereignty.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">About</h1>
	<div class="prose prose-cactus max-w-none">
		<p>
			I go by <strong>thesvn</strong> on the internet. I'm a financial markets analyst turned developer,
			primarily focused on Bitcoin, Rust, and the broader sovereign tech stack.
		</p>
		<p>
			Most of my time is spent writing Rust, doing security research, and thinking about systems that
			resist coercion. I believe in open source, self-custody, and systems that work without asking
			permission.
		</p>
		<p>
			I also like to write and am trying to get better at it.
		</p>
	</div>
</PageLayout>
